# Neon Postgres
DATABASE_URL=

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Skydropx (Pro / v2 OAuth2 — usa client_id + client_secret)
# Las credenciales se obtienen en app.skydropx.com/mx/merchant_stores/applications
SKYDROPX_API_KEY=
SKYDROPX_API_SECRET=
SKYDROPX_ORIGIN_ZIP=
SKYDROPX_ORIGIN_STATE=
SKYDROPX_ORIGIN_CITY=
SKYDROPX_ORIGIN_NEIGHBORHOOD=

# Facturapi
# El controller elige automáticamente según NODE_ENV:
#   - production → FACTURAPI_API_KEY_LIVE (emite CFDIs reales al SAT)
#   - cualquier otro → FACTURAPI_API_KEY_TEST (sandbox, no toca al SAT)
FACTURAPI_API_KEY_LIVE=
FACTURAPI_API_KEY_TEST=

# Brevo — https://app.brevo.com
BREVO_API_KEY=
# Sender debe estar verificado en Brevo (Settings > Senders & IPs)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Ejecutar: node server/scripts/create-brevo-templates.mjs para crear las plantillas
BREVO_ARRIVAL_TEMPLATE_ID=
BREVO_WELCOME_TEMPLATE_ID=
BREVO_ORDER_CONFIRM_TEMPLATE_ID=
# Template para el correo intermedio "estamos verificando tu pago" (OXXO/SPEI)
BREVO_PAYMENT_VERIFICATION_TEMPLATE_ID=
# ID de la lista principal de contactos (Contacts > Lists)
BREVO_MAIN_LIST_ID=
# WhatsApp de contacto para que el cliente envíe comprobantes de pago manual
WHATSAPP_NUMBER=

# Mercado Pago
PAYMENT_ACCESS_TOKEN=          # APP_USR-... (token de producción)
PAYMENT_ACCESS_TOKEN_TEST=     # TEST-... (token sandbox — se usa automáticamente fuera de NODE_ENV=production)
PAYMENT_WEBHOOK_SECRET=

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# General
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
